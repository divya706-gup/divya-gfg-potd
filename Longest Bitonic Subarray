class Solution {
  public:
    int bitonic(vector<int> &arr) {
        // code here
        int n=arr.size();
        if (n <= 2){
            return n;
        } 
        
        vector<int>includeArray(n,1);
        for(int i=1;i<n;i++){
            
            if(arr[i]>=arr[i-1]){
                includeArray[i]=includeArray[i-1]+1;
            }
            
        }
        vector<int>excludeArray(n,1);
        for(int i=n-2;i>=0;i--){
            
            if(arr[i]>=arr[i+1]){
                excludeArray[i]=excludeArray[i+1]+1;
            }
            
        }
        int max_len = 1;
        for (int i = 0; i < n; i++) {
            max_len = max(max_len, includeArray[i] + excludeArray[i] - 1);
        }

        return max_len;
       
    }
};
