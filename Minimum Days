class Solution {
public:
    int getMinimumDays(string &s, vector<int> &p) {
        int n = s.length();
        int conflicts = 0;
        for (int i = 0; i < n - 1; i++) {
            if (s[i] == s[i + 1]) {
                conflicts++;
            }
        }
        if (conflicts == 0) return 0;
        for (int i = 0; i < n; i++) {
            int idx = p[i];
            if (idx > 0 && s[idx] == s[idx - 1]) {
                conflicts--;
            }
            if (idx < n - 1 && s[idx] == s[idx + 1]) {
                conflicts--;
            }
            s[idx] = '?';
            if (conflicts == 0) {
                return i + 1;
            }
        }

        return 0;
    }
};
