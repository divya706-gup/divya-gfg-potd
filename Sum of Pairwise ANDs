class Solution {
  public:
    long long pairAndSum(vector<int> &arr) {
        // code here
        int n = arr.size();
        long long ans=0;
        for(int i=0;i<32;i++){
            long long k=0;
            for(int j=0;j<n;j++){
                if(arr[j]&(1LL<<i)){
                    k++;
                }
            }
            ans += (1LL << i)*(k*(k-1)/2);
        }
        return ans;
    }
};
