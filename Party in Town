class Solution {
	public:
	
	pair<int, int> bfs(int start, int n,vector<vector<int>> & adj) {
		
		vector<int> dist(n+1, -1);
		queue<int> q;
		
		q.push(start);
		dist[start] = 0;
		int farthestNode = start;
		
		while (!q.empty()) {
			int u = q.front();
			q.pop();
			
			for (int v : adj[u-1]) {
				if (dist[v] == -1) {
					dist[v] = dist[u] + 1;
					q.push(v);
					if (dist[v] > dist[farthestNode]) {
						farthestNode = v;
					}
				}
			}
		}
		return {farthestNode, dist[farthestNode]};
	}
	
	int partyHouse(vector<vector<int>> & adj) {
	    int N=adj.size();
		pair<int, int> p1 = bfs(1,N,adj);
		pair<int, int> p2 = bfs(p1.first,N, adj);
		int diameter = p2.second;
		return (diameter + 1) / 2;
	}
};
