

class Solution {
public:
    int zigzagSequence(vector<vector<int>>& mat) {
        int n = mat.size();
        if (n == 0) return 0;
        if (n == 1) return mat[0][0];

        vector<int> dp = mat[0];

        for (int i = 1; i < n; ++i) {
            int max1 = -1, max2 = -1;
            int max1_col = -1;

            for (int j = 0; j < n; ++j) {
                if (dp[j] > max1) {
                    max2 = max1;
                    max1 = dp[j];
                    max1_col = j;
                } else if (dp[j] > max2) {
                    max2 = dp[j];
                }
            }

           vector<int> next_dp(n);
            for (int j = 0; j < n; ++j) {
                int prev_max = (j == max1_col) ? max2 : max1;
                next_dp[j] = mat[i][j] + prev_max;
            }

            dp = move(next_dp);
        }

        return *max_element(dp.begin(), dp.end());
    }
};
