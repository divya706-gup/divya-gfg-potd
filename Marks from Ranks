class Solution {
	public:
	int findIntervals(vector<int>&prefix, int rank) {
		int low = 0;
		int high = prefix.size() - 1;
		while (low<high) {
			int mid = low + (high - low) / 2;
			
			if (prefix[mid] < rank) {
				low = mid + 1;
			}
			else {
				high = mid;
			}
		}
		return low;
	}
	vector<int> getMarks(vector<int> &l, vector<int> &r, vector<int> &rank) {
		// code here
		int n = l.size();
		vector<int>prefix(n);
		prefix[0]=r[0]-l[0]+1;
		for (int i = 1; i < n; i++) {
			prefix[i] = prefix[i - 1] + (r[i] - l[i] + 1);
		}
		vector<int> ans(rank.size());
		for (int i = 0; i<rank.size(); i++) {
			int idx = findIntervals(prefix, rank[i]);
			int prevCount = (idx > 0) ? prefix[idx - 1] : 0;
			int offset = rank[i] - prevCount - 1;
			ans[i] = l[idx] + offset;
		}
		return ans;
	}
};
