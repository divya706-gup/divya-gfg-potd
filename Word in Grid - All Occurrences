class Solution {
  public: 
    int dx[8] = {-1, -1, -1, 0, 0, 1, 1, 1};
    int dy[8] = {-1, 0, 1, -1, 1, -1, 0, 1};
    bool isPossible(vector<vector<char>>&mat,int i,int j,string& word){
        int n=mat.size();
        int m=mat[0].size();
        int l=word.length();
        for(int d=0;d<8;d++){
            int k;
            for( k=0;k<l;k++){
                int newR=i+k*dx[d];
                int newC=j+k*dy[d];
                if(newR<0||newR>=n||newC<0||newC>=m||mat[newR][newC]!=word[k]){
                    break;
                }
            }
            if(k==l){
                return true;   
            }
        }
        return false;
    }
    vector<vector<int>> searchWord(vector<vector<char>> &mat, string &word) {
        // Code here
        int n=mat.size();
        int m=mat[0].size();
        vector<vector<int>>result;
        vector<int>ans;
        for(int i=0;i<n;i++){
            for(int j=0;j<m;j++){
                if(isPossible(mat,i,j,word)){
                    ans.push_back(i);
                    ans.push_back(j);
                    result.push_back(ans);
                    ans.pop_back();
                    ans.pop_back();
                }
                
            }
        }
        return result;
    }
};
