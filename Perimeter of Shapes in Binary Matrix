class Solution {
	public:
	int findPerimeter(vector<vector<int>> &mat) {
		// code here
		int n = mat.size();
		int m = mat[0].size();
		int perimeter = 0;
		int dr[] = {-1, 1, 0, 0};
		int dc[] = {0, 0, -1, 1};
		for (int i = 0; i<n; i++) {
			for (int j = 0; j<m; j++) {
				if (mat[i][j] == 0) {
					continue;
				}
				for (int d = 0; d<4; d++) {
					int nr = i + dr[d];
					int nc = j + dc[d];
					if (nr<0 || nr >= n || nc<0 || nc >= m || mat[nr][nc] == 0) {
						perimeter++;
					}
				}
			}
		}
		return perimeter;
	}
};
