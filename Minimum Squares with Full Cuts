class Solution {
  public:
    int minSquares(int n, int m) {
        // code here
        int count=0;
        int size=n*m;
        if(n==m){
            return 1;
        }
        int a,b;
        if(n<m){
            swap(n,m);
        }
        while(m>0){
            count += n/m;
            int rem=n%m;
            n=m;
            m=rem;
        }
