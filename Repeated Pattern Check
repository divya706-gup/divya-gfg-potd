class Solution {
	public:
	bool findPattern(string& s) {
		// code here
		int n = s.size();
		int i = 0;
		while (i<n) {
			int countX = 0;
			int countY = 0;
			while (i < n && s[i] == 'x') {
				countX++;
				i++;
			}
			while (i < n && s[i] == 'y') {
				countY++;
				i++;
			}
			if (countX == 0 || countX != countY) {
				return false;
			}
		}
		return true;
	}
};
