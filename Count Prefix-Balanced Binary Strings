class Solution {
  public:
    int prefixStrings(int n) {
        // code here
        const long long MOD = 1000000007;
        vector<long long >dp(n+1,0);
        dp[0]=1;
        for(int i=1;i<=n;i++){
            for(int j=0;j<i;j++){
                dp[i] = (dp[i] + dp[j] * dp[i - 1 - j]) % MOD;
            }
        }
        return dp[n];
    }
};
