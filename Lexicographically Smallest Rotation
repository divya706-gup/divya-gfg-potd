class Solution {
public:
    string lexiString(string &s) {
        int n = s.length();
        string doubled = s + s;
        int i = 0; 
        int j = 1;
        int k = 0; 
        while (i < n && j < n && k < n) {
            if (doubled[i + k] == doubled[j + k]) {
                k++;
            } else if (doubled[i + k] > doubled[j + k]) {
                i = i + k + 1;
                if (i <= j) {
                    i = j + 1;
                }
                k = 0;
            } else {
                j = j + k + 1;
                if (j <= i) {
                    j = i + 1;
                }
                k = 0;
            }
        }
        int start = min(i, j);
        return doubled.substr(start, n);
    }
};
