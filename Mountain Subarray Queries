class Solution {
public:
    vector<bool> processQueries(vector<int> &arr, vector<vector<int>> &queries) {
        int n = arr.size();
        vector<int> max_inc(n, 0);
        vector<int> max_dec(n, 0);
        
        // Precompute max_dec: furthest right we can go while non-increasing
        max_dec[n - 1] = n - 1;
        for (int i = n - 2; i >= 0; i--) {
            if (arr[i] >= arr[i + 1]) {
                max_dec[i] = max_dec[i + 1];
            } else {
                max_dec[i] = i;
            }
        }
        
        // Precompute max_inc: furthest right we can go while non-decreasing
        max_inc[n - 1] = n - 1;
        for (int i = n - 2; i >= 0; i--) {
            if (arr[i] <= arr[i + 1]) {
                max_inc[i] = max_inc[i + 1];
            } else {
                max_inc[i] = i;
            }
        }
        
        // Process each query in O(1) time
        vector<bool> ans;
        for (const auto& q : queries) {
            int l = q[0];
            int r = q[1];
            
            // Find the peak from 'l', then see how far down we can go from that peak
            int peak = max_inc[l];
            if (max_dec[peak] >= r) {
                ans.push_back(true);
            } else {
                ans.push_back(false);
            }
        }
        
        return ans;
    }
};
