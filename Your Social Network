class Solution {
  public:
    vector<vector<int>> socialNetwork(vector<int>& arr) {
        // code here
        int n=arr.size()+1;
        vector<vector<int>>graph(n+1);
        for(int i=0;i<arr.size();i++){
            int user=i+2;
            graph[user].push_back(arr[i]);
        }
        vector<vector<int>>ans;
        for(int i=2;i<=n;i++){
            queue<int>q;
            vector<int>dist(n+1,-1);
            q.push(i);
            dist[i]=0;
            while(!q.empty()){
                int u=q.front();
                q.pop();
                for(int v:graph[u]){
                    if(dist[v]==-1){
                        dist[v]=dist[u]+1;
                        q.push(v);
                    }
                }
            }
            for(int j=1;j<i;j++){
                if(dist[j]!=-1){
                    ans.push_back({i,j,dist[j]});
                }
            }
        }
        return ans;
    }
};
