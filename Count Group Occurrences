class Solution {
  public:
    int getCount(string &s, int k) {
        // code here
        int n=s.length();
        int freq[26]={0};
        int i=0;
        while(i<n){
            int j=i;
            while(j<n && s[i]==s[j]){
                j++;
            }
            freq[s[i] - 'a']++;
            i=j;
        }
        int ans=0;
        for(int i=0;i<26;i++){
            if(freq[i]==k){
                ans++;
            }
        }
        return ans;
    }
};
