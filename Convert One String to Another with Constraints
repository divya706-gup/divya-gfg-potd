class Solution {
	public:
	bool isItPossible(string &s1, string &s2) {
		// code here
		int m = s1.length();
		int n = s2.length();
		if (m != n) {
			return false;
		}
		int i=0,j=0;
		while (i<m || j<n) {
			while (i < m && s1[i] == '#') {
				i++;
			}
			while (j < n && s2[j] == '#') {
				j++;
			}
			if (i >= m && j >= n) {
				break;
			}
			if (i >= m || j >= n) {
				return false;
			}
			if (s1[i] != s2[j]) {
				return false;
			}
			if (s1[i] == 'A' && i < j) {
				return false;
			}
			if (s1[i] == 'B' && i > j) {
				return false;
			}
			i++;
			j++;
		}
		return true;
	}
};
