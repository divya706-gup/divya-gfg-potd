class Solution {
	public:
	string findRollOut(string& s, vector<int>& roll) {
		// code here
		int n = s.size();
		int m = roll.size();
		vector<int>diff(n + 1, 0);
		for (int i = 0; i < m; i++) {
			diff[0] += 1;
			if (roll[i] < n)
				{
				diff[roll[i]] -= 1;
			}
		}
		for (int i = 1; i < n; i++) {
			diff[i] += diff[i - 1];
		}
		for (int i = 0; i < n; i++) {
			int shift = diff[i] % 26;
			s[i] = char('a' + (s[i] - 'a' + shift) % 26);
		}
		return s;
	}
};
