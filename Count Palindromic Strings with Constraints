class Solution {
	public:
	int palindromicStrings(int n, int k) {
		// code here
		const int MOD = 1e9 + 7;
		long long res = 0;
		long long nPr[k + 1][k + 1];
		memset(nPr, 0, sizeof(nPr));
		for (int i = 0; i<=k; i++) {
			for (int j = 0; j <= i; j++) {
				if (j == 0) {
					nPr[i][j] = 1;
				}
				else {
					nPr[i][j] = (nPr[i - 1][j] % MOD + (j * nPr[i - 1][j - 1]) % MOD) % MOD;
				}
			}
		}
		for (int i = 1; i <= n / 2; i++) {
			res = (res + nPr[k][i]) % MOD;
		}
		res = (res * 2) % MOD;
		if (n & 1){
			res = (res + nPr[k][n / 2 + 1]) % MOD;
		}
		return (int)res;
	}
};
