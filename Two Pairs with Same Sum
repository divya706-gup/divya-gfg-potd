class Solution {
  public:
    vector<int> findPairs(vector<int>& arr) {
        int n = static_cast<int>(arr.size());
        unordered_map<int, pair<int, int>> sumToPair;
        vector<int> ans;

        for (int i = 0; i < n; ++i) {
            for (int j = i + 1; j < n; ++j) {
                int sum = arr[i] + arr[j];
                auto it = sumToPair.find(sum);

                if (it != sumToPair.end()) {
                    int a = it->second.first;
                    int b = it->second.second;

                    if (a != i && a != j && b != i && b != j) {
                        vector<int> curr = {a, b, i, j};
                        if (ans.empty() || curr < ans) {
                            ans = curr;
                        }
                    }
                } else {
                    sumToPair[sum] = {i, j};
                }
            }
        }

        if (ans.empty()) {
            return {-1, -1, -1, -1};
        }
        return ans;
    }
};
