class Solution {
	public:
	int formPyramid(vector<int>& arr) {
		// code here
		int n = arr.size();
		long long totalSum = 0;
		for (int x : arr) {
			totalSum += x;
		}
		vector<int>left(n);
		vector<int>right(n);
		left[0] = min(arr[0], 1);
		for (int i = 1; i<n; i++) {
			left[i] = min(arr[i], left[i - 1]+1);
		}
		right[n - 1] = min(arr[n - 1], 1);
		for (int i = n - 2; i >= 0; i--) {
			right[i] = min(arr[i], right[i + 1]+1);
		}
		long long maxPyramidSum = 0;
		for (int i = 0; i<n; i++) {
			long long peakHeight = min(left[i], right[i]);
			long long sumpyramid = peakHeight*peakHeight;
			maxPyramidSum = max(maxPyramidSum, sumpyramid);
		}
		return totalSum - maxPyramidSum;
	}
};
