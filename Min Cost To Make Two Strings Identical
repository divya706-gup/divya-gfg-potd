class Solution {
	public:
	int findMinCost(string &s1, string &s2, int costS1, int costS2) {
		// code here
		int n=s1.length();
		int m=s2.length();
		if (n<m) {
			swap(s1, s2);
			swap(costS1, costS2);
			swap(n,m);
		}
		
		vector<int>curr(m+1,0),prev(m+1,0);
		for(int i=1;i<=n;i++){
		    for(int j=1;j<=m;j++){
		        if(s1[i-1]==s2[j-1]){
		            curr[j]=prev[j-1]+1;
		        }
		        else{
		            curr[j]=max(curr[j-1],prev[j]);
		        }
		    }
		   prev=curr;
		}
		int count=prev[m];
		return (n-count)*costS1+(m-count)*costS2;
	}
};
