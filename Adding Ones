class Solution {
  public:
    vector<int> update(int n, vector<int>& updates) {
        // code here
        vector<int>arr(n,0);
        for(int j:updates){
            ++arr[j-1];
        }
        int count=0;
        for(int i=0;i<n;i++){
            count +=arr[i];
            arr[i]=count;
        }
        return arr;
    }
};
