class Solution {
  public:
    void dfs(Node* root,int expectedVal,int currLen,int& maxLen){
        if(root==NULL){
            return ;
        }
        if (root->data == expectedVal) {
            currLen++;
        } else {
            currLen = 1;
        }
        maxLen = max(maxLen, currLen);
        dfs(root->left, root->data + 1, currLen, maxLen);
        dfs(root->right, root->data + 1, currLen, maxLen);
    }
    
    int longestConsecutive(Node* root) {
        // code here
        if(root==NULL){
            return -1;
        }
        int maxLen = 0;
        dfs(root, root->data, 0, maxLen);
        return (maxLen > 1) ? maxLen : -1;
    }
};
