class Solution {
	public:
	string compress(string &s) {
		// code here
		string ans = "";
		int n = s.length();
		int i = n - 1;
		vector<int>lps(n,0);
		for (int i = 1; i<n; i++) {
			int j = lps[i - 1];
			while (j>0 && s[i] != s[j]) {
				j = lps[j - 1];
			}
			if (s[i] == s[j]) {
				j++;
			}
			lps[i] = j;
		}
		while(i>=0){
		    if(i%2==1){
		      int len=i+1;
		      int period=len-lps[i];
              if(lps[i]>=len/2 && len%(2*period)==0){
                  ans += "*";
                  i=i/2+1;
              }
              else{
                  ans += s[i];
              }
		      
		    }
		    else{
		        ans += s[i];
		    }
		    i--;
		}
		reverse(ans.begin(),ans.end());
		return ans;
	}
};
