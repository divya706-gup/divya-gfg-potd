class Solution {
    public:
      int numberOfCells(int r, int c, int u, int d, vector<vector<char>> &mat) {
          int n = mat.size();
          int m = mat[0].size();

          if (mat[r][c] == '#') return 0;

          vector<vector<pair<int, int>>> dist(n, vector<pair<int, int>>(m, {1e9, 1e9}));
          deque<tuple<int, int, int, int>> dq;

          dist[r][c] = {0, 0};
          dq.push_front({0, 0, r, c});

          int dr[] = {-1, 1, 0, 0};
          int dc[] = {0, 0, -1, 1};

          while (!dq.empty()) {
              auto [upUsed, downUsed, x, y] = dq.front();
              dq.pop_front();

              for (int i = 0; i < 4; i++) {
                  int nx = x + dr[i];
                  int ny = y + dc[i];

                  if (nx >= 0 && nx < n && ny >= 0 && ny < m && mat[nx][ny] == '.') {
                      int nUp = upUsed + (i == 0 ? 1 : 0);
                      int nDown = downUsed + (i == 1 ? 1 : 0);

                      if (nUp <= u && nDown <= d) {
                          if (nUp < dist[nx][ny].first || nDown < dist[nx][ny].second) {
                              dist[nx][ny] = {nUp, nDown};

                              if (i >= 2) {
                                  dq.push_front({nUp, nDown, nx, ny});
                              } else {
                                  dq.push_back({nUp, nDown, nx, ny});
                              }
                          }
                      }
                  }
              }
          }

          int count = 0;
          for (int i = 0; i < n; i++) {
              for (int j = 0; j < m; j++) {
                  if (dist[i][j].first <= u && dist[i][j].second <= d) {
                      count++;
                  }
              }
          }

          return count;
      }
  };
