class Solution {
  public:
    int maxTask(vector<int>& h, vector<int>& l) {
        // code here
        int n = h.size();
        if (n == 0) return 0;
        if (n == 1) return std::max(h[0], l[0]);

        int prev2 = 0;
        int prev1 = std::max(h[0], l[0]);

        for (int i = 1; i < n; ++i) {
            int curr = std::max(prev1 + l[i], prev2 + h[i]);
            prev2 = prev1;
            prev1 = curr;
        }

        return prev1;
    }
};
