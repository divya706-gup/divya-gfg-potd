class Solution {
  public:
    int longestSubarrayDivK(vector<int>& arr, int k) {
        // code here
        unordered_map<int,int>mp;
        mp[0]=-1;
        long long sum=0;
        int n=arr.size();
        int ans=0;
        for(int i=0;i<n;i++){
            sum +=arr[i];
            int r=(int)(((sum%k)+k)%k);
            if(mp.count(r)){
                ans=max(ans,i-mp[r]);
            }
            else{
                mp[r]=i;
            }
        }
        return ans;
    }
};
