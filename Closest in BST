/* Structure of a Binary Search Tree node
class Node {
	public:
	int data;
	Node* left;
	Node* right;
	
	Node(int val) {
		data = val;
		left = right = nullptr;
	}
};
*/

class Solution {
	public:
	int minDiff(Node *root, int k) {
		// code here
		int min_diff = __INT_MAX__;
		Node* curr = root;
		while (curr != nullptr) {
			min_diff = min(min_diff, abs(curr->data - k));
			if (curr->data == k) {
				return 0;
			} else if (curr->data > k) {
				curr = curr->left;
			} else {
				curr = curr->right;
			}
		}
		return min_diff;
	}
};
