class Solution {
	public:
	vector<int> lexicographicallyLargest(vector<int> &arr) {
		// code here
		int n = arr.size();
		int i = 0;
		while (i < n)
			{
			int j = i + 1;
			
			while (j < n && arr[j] % 2 == arr[j - 1] % 2) {
				j++;
			}
			sort(arr.begin() + i, arr.begin() + j, greater<int>());
			
			i = j;
		}
		return arr;
	}
};
