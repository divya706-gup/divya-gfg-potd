class Solution {
	public:
	int maxFruits(vector<int>& arr, int m) {
		// code here
		int n = arr.size();
		if (m >= n) {
			int t = 0;
			for (int val:arr) {
				t += val;
			}
			return t;
		}
		int sum = 0;
		for (int i = 0; i<m; i++) {
			sum += arr[i];
		}
		int result = sum;
		
		for (int i = m; i<m + n - 1; i++) {
			sum += arr[i%n];
			sum -= arr[(i - m)%n];
			result = max(result, sum);
			
		}
		return result;
	}
};
