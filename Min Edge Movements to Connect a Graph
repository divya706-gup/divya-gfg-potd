class Solution {
  public:
    void dfs(int i,vector<int>&visited,vector<vector<int>>&adj){
        visited[i]=true;
        for(auto nei:adj[i]){
            if(!visited[nei]){
                dfs(nei,visited,adj);
            }
        }
    }
    int minEdgesReq(int n, vector<vector<int>>& edges) {
        // code here
        if((int)edges.size()<n-1){
            return -1;
        }
        vector<vector<int>> adj(n);
        for(auto edge:edges){
            int u=edge[0];
            int v=edge[1];
            adj[u].push_back(v);
            adj[v].push_back(u);
        }
        vector<int>visited(n,false);
        int components=0;
        for(int i=0;i<n;i++){
            if(!visited[i]){
                components++;
                dfs(i,visited,adj);
            }
        }
        return components-1;
    }
};
