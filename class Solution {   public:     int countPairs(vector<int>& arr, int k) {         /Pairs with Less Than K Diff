class Solution {
  public:
    int countPairs(vector<int>& arr, int k) {
        // code here
        int count=0;
        sort(arr.begin(),arr.end());
        int s=0;
        for(int i=0;i<arr.size();i++){
            while(arr[i]-arr[s]>=k){
                s++;
            }
            count += (i-s);
        }
        return count;
    }
};
