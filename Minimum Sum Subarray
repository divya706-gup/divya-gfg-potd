class Solution {
  public:
    int minSubarraySum(vector<int> &arr) {
        // code here
        int n=arr.size();
        int curr_min=INT_MAX;
        int ans=INT_MAX;
        for(int i=0;i<n;i++){
            if(curr_min>0){
                curr_min=arr[i];
            }
            else{
                curr_min +=arr[i];
            }
            ans=min(ans,curr_min);
        }
        return ans;
    }
};
