class Solution {
	public:
	int solve(Node* root, int &res) {
		if (root == nullptr) {
			return INT_MIN;
		}
		if (root->left == nullptr && root->right == nullptr) {
			return root->data;
		}
		int leftSum = solve(root->left, res);
		int rightSum = solve(root->right, res);
		if (root->left && root->right) {
			res = max(res, leftSum + rightSum + root->data);
			return max(leftSum, rightSum) + root->data;
		}
	    return (root->left != NULL ? leftSum : rightSum) + root->data;
         
	}
	int maxPathSum(Node *root) {
		// code here
		if (root == NULL) return -1;
		int res = INT_MIN;
		int val=solve(root, res);
		if(root->left && root->right){
		    return res;
		}
		if(res!=INT_MIN){
		  return res;  
		}
		return -1;
	}
};
