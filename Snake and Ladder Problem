class Solution {
	public:
	int minThrows(int n, vector<int>& lad, vector<int>& sn) {
		// code here
		vector<int>moves(n*n + 1, -1);
		vector<int>visited(n*n + 1, false);
		for (int i = 0; i<lad.size(); i = i + 2) {
			moves[lad[i]] = lad[i + 1];
		}
		for (int i = 0; i<sn.size(); i = i + 2) {
			moves[sn[i]] = sn[i + 1];
		}
		queue<pair<int, int>> q;
		q.push({1, 0});
		visited[1] = true;
		pair<int, int>curr;
		while (!q.empty()) {
			curr = q.front();
			q.pop();
			int p = curr.first;
			int dist = curr.second;
			if (p == n*n) {
				return dist;
			}
			for (int dice = 1; dice <= 6; dice++) {
				int next = p + dice;
				if (next <= n*n) {
					int dest = (moves[next] != -1) ? moves[next] : next;
					if (!visited[dest]) {
						visited[dest] = true;
						q.push({dest, dist + 1});
					}
				}
			}
		}
		return - 1;
	}
};
