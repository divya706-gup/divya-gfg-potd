class Solution {
  public:
    string decimalToBinary(int n) {
        if (n == 0) return "0";
        string binary = "";
        while (n > 0) {
            binary += (n % 2 == 0 ? "0" : "1");
            n /= 2;
        }
        reverse(binary.begin(), binary.end());
        return binary;
    }
    int maxValue(int n) {
        string num = decimalToBinary(n);
        for (int i = 0; i <= (int)num.length() - 3; i++) {
            if (num[i] == '1' && num[i+1] == '1' && num[i+2] == '1') {
                num[i+2] = '0';
                i = -1;
            }
        }
        int result = 0;
        for (char c : num) {
            result = result * 2 + (c - '0');
        }
        return result;
    }
};
