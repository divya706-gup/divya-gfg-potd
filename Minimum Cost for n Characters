class Solution {
  public:
    int minCost(int n, int i, int d, int c) {
        // code here
        if(n==0){
            return 0;
        }
        if(n==1){
            return i;
        }
        vector<int>dp(n+1,0);
        dp[1]=i;
        for(int x=2;x<=n;x++){
            if(x%2==0){
                dp[x]=min(dp[x - 1] + i, dp[x / 2] + c);
            }
            else{
                 dp[x] = min(dp[x - 1] + i, dp[(x + 1) / 2] + c + d);
            }
        }
        return dp[n];
    }
};
